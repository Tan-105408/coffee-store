generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}
model User {
  id            Int            @id @default(autoincrement())
  username      String
  email         String         @unique
  password      String?
  role          String         @default("user")
  isActive      Boolean        @default(true)
  googleId      String?        @unique
  address       String?        @db.NVarChar(Max)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  reviews       Review[]
  carts         Cart[]
  orders        Order[]
  refreshTokens RefreshToken[]
  userVouchers  UserVoucher[]
}
model Product {
  id                Int      @id @default(autoincrement())
  name              String
  price             Float
  image             String
  description       String?  @db.NVarChar(Max)
  category          String   @default("Cà phê")
  discount          Int      @default(0)
  isBestSeller      Boolean  @default(false)
  bestSellerOverride Boolean?
  bestSellerReason  String?  @db.NVarChar(500)
  promoTag          String?  @db.NVarChar(100)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  reviews           Review[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
}
model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}
model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)
  options   String? @db.NVarChar(Max)
}
model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?  @db.NVarChar(Max)
  createdAt DateTime @default(now())
}
model PaymentTransaction {
  id            Int      @id @default(autoincrement())
  orderId       Int
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderCode     String?  @unique
  provider      String
  status        String   @default("pending")
  transactionId String?
  amount        Float
  currency      String   @default("VND")
  errorCode     String?
  errorMessage  String?
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
model Order {
  id                Int       @id @default(autoincrement())
  userId            Int
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalAmount       Float
  status            String    @default("pending")
  paymentMethod     String    @default("cash")
  paymentStatus     String    @default("pending")
  paymentTimestamp  DateTime?
  paymentTransactions PaymentTransaction[]
  deliveryAddress   String?   @db.NVarChar(Max)
  deliveryTime      DateTime?
  estimatedReadyTime DateTime?
  note              String?   @db.NVarChar(Max)
  orderItems        OrderItem[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}
model OrderItem {
  id              Int     @id @default(autoincrement())
  orderId         Int
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       Int
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity        Int
  priceAtPurchase Float
  options         String? @db.NVarChar(Max)
}
model SiteSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String @db.NVarChar(Max)
}
model Promotion {
  id            Int       @id @default(autoincrement())
  name          String
  type          String
  buyQuantity   Int?
  getQuantity   Int?
  minQuantity   Int?
  discount      Float?
  freeProductId Int?
  isActive      Boolean   @default(true)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime  @default(now())
}
model Voucher {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  description   String?   @db.NVarChar(500)
  discountType  String
  discountValue Float
  minOrderValue Float?
  maxDiscount   Float?
  usageLimit    Int?
  usedCount     Int       @default(0)
  isActive      Boolean   @default(true)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  userVouchers  UserVoucher[]
  voucherRules  VoucherRule[]
}
model UserVoucher {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  voucherId Int
  voucher   Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  isUsed    Boolean  @default(false)
  usedAt    DateTime?
  createdAt DateTime @default(now())
}
model VoucherRule {
  id          Int      @id @default(autoincrement())
  name        String
  triggerType String
  threshold   Float
  voucherId   Int
  voucher     Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  isActive    Boolean  @default(true)
}
