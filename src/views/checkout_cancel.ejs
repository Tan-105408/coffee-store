<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Thanh toán bị hủy - Coffee Store</title>
  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/style.css">
  <style>
    .cancel-animation { animation: shake 0.6s ease-out; }
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      20%, 60% { transform: translateX(-10px); }
      40%, 80% { transform: translateX(10px); }
    }
    .cancel-circle {
      width: 120px; height: 120px;
      background: linear-gradient(135deg, #e76f51, #f4a261);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 10px 40px rgba(231, 111, 81, 0.3);
    }
    .help-card {
      border: 1px solid rgba(231, 111, 81, 0.2);
      border-radius: 16px;
      background: linear-gradient(to bottom, #fffdfb, #fff);
    }
    .help-card:hover { border-color: rgba(231, 111, 81, 0.5); }
  </style>
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
  <!-- Header -->
  <header>
    <nav class="navbar navbar-expand-lg co-navbar navbar-dark sticky-top">
      <div class="container">
        <a class="navbar-brand d-flex align-items-center" href="/">
          <span class="fs-3 me-2">☕</span>
          <span class="font-serif fw-bold">Coffee Store</span>
        </a>
      </div>
    </nav>
  </header>

  <main class="container flex-grow-1 d-flex align-items-center justify-content-center py-5">
    <div class="co-detail-card shadow-lg text-center p-5 rounded-4 cancel-animation" style="max-width: 550px;">
      <div class="cancel-circle mx-auto mb-4">
        <i class="bi bi-x-lg text-white" style="font-size: 4rem;"></i>
      </div>
      <h2 class="font-serif fw-bold text-dark mb-3">Thanh toán đã bị hủy</h2>
      <p class="text-muted mb-4">Giao dịch của bạn đã bị hủy hoặc gặp sự cố. Bạn có thể thử lại.</p>

      <div class="help-card p-4 mb-4 text-start">
        <h6 class="fw-bold mb-3 text-danger"><i class="bi bi-lightbulb me-2"></i>Gợi ý</h6>
        <ul class="list-unstyled mb-0">
          <li class="mb-2"><i class="bi bi-check2 text-success me-2"></i>Kiểm tra kết nối internet</li>
          <li class="mb-2"><i class="bi bi-check2 text-success me-2"></i>Thử phương thức thanh toán khác</li>
          <li class="mb-0"><i class="bi bi-check2 text-success me-2"></i>Liên hệ hỗ trợ nếu cần</li>
        </ul>
      </div>

      <div class="d-flex gap-3 justify-content-center flex-wrap">
        <a href="/cart" class="co-btn co-btn-secondary px-4 py-3 fw-bold">
          <i class="bi bi-cart3 me-2"></i> Về giỏ hàng
        </a>
        <a href="/" class="co-btn co-btn-primary px-4 py-3 fw-bold">
          <i class="bi bi-shop me-2"></i> Menu
        </a>
      </div>
    </div>
  </main>

  <footer class="co-footer mt-5">
    <div class="container text-center">
      <p class="m-0 text-white-50 small">&copy; 2026 Coffee Store. Tất cả quyền được bảo lưu.</p>
    </div>
  </footer>
</body>
</html>