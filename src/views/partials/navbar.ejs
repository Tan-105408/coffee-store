<!-- Shared Navbar Partial -->
<header>
  <nav class="navbar navbar-expand-lg co-navbar navbar-dark sticky-top">
    <div class="container">
      <a class="navbar-brand" href="/">
        <span class="brand-icon">☕</span>
        <span>Coffee Store</span>
      </a>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#coNavbar" aria-controls="coNavbar" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="coNavbar">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
          <li class="nav-item">
            <a class="nav-link<%= typeof activePage !== 'undefined' && activePage === 'home' ? ' active' : '' %>" href="/"><i class="bi bi-house-door me-1"></i> Trang chủ</a>
          </li>
          <li class="nav-item">
            <a class="nav-link<%= typeof activePage !== 'undefined' && activePage === 'cart' ? ' active' : '' %>" href="/cart"><i class="bi bi-cart3 me-1"></i> Giỏ hàng</a>
          </li>
          <li class="nav-item">
            <a class="nav-link<%= typeof activePage !== 'undefined' && activePage === 'orders' ? ' active' : '' %>" href="/order/history"><i class="bi bi-bag-check me-1"></i> Đơn hàng</a>
          </li>
        </ul>

        <div class="d-flex align-items-center gap-2">
          <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
            <a href="/admin" class="co-btn co-btn-accent co-btn-sm">
              <i class="bi bi-speedometer2 me-1"></i> Admin
            </a>
          <% } %>

          <% if (typeof user !== 'undefined' && user) { %>
            <div class="dropdown">
              <button class="co-user-btn dropdown-toggle" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle"></i>
                <span><%= user.username %></span>
              </button>
              <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenu">
                <li><a class="dropdown-item" href="/auth/profile"><i class="bi bi-person me-2"></i>Hồ sơ cá nhân</a></li>
                <li><a class="dropdown-item" href="/order/history"><i class="bi bi-bag me-2"></i>Đơn hàng của tôi</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item text-danger" href="/auth/logout"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
              </ul>
            </div>
          <% } else { %>
            <a href="/auth/login" class="co-btn co-btn-ghost co-btn-sm">
              <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
            </a>
            <a href="/auth/register" class="co-btn co-btn-accent co-btn-sm">
              <i class="bi bi-person-plus me-1"></i> Đăng ký
            </a>
          <% } %>
        </div>
      </div>
    </div>
  </nav>
</header>
