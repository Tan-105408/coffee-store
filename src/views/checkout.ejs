<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Thanh toán - Coffee Store</title>
  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <!-- SweetAlert2 -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/style.css">
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
  <!-- Header -->
  <header>
    <nav class="navbar navbar-expand-lg co-navbar navbar-dark sticky-top">
      <div class="container">
        <a class="navbar-brand d-flex align-items-center" href="/">
          <span class="fs-3 me-2">☕</span>
          <span class="font-serif fw-bold">Coffee Store</span>
        </a>
        <div class="navbar-nav ms-auto">
          <a class="nav-link" href="/"><i class="bi bi-house-door me-1"></i> Trang chủ</a>
        </div>
      </div>
    </nav>
  </header>
  
  <main class="container flex-grow-1 py-5">
    <h2 class="font-serif fw-bold mb-4"><i class="bi bi-credit-card me-2"></i> Xác nhận thanh toán</h2>

    <div class="row g-5">
      <!-- Order Summary -->
      <div class="col-lg-5 order-lg-2">
        <div class="co-summary-card shadow-lg sticky-top" style="top: 100px;">
          <h4 class="font-serif fw-bold mb-4">Đơn hàng của bạn</h4>
          <div class="summary-list mb-4">
            <% cart.forEach(item => { %>
              <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                <div>
                  <p class="fw-semibold text-dark m-0"><%= item.name %></p>
                  <small class="text-muted">SL: <%= item.quantity %></small>
                </div>
                <span class="fw-bold text-dark"><%= item.total.toLocaleString() %>đ</span>
              </div>
            <% }); %>
          </div>
          <div class="d-flex justify-content-between border-top pt-3 fw-bold fs-4 text-success">
            <span>Tổng cộng:</span>
            <span><%= total.toLocaleString() %>đ</span>
          </div>
        </div>
      </div>

      <!-- Checkout Form -->
      <div class="col-lg-7 order-lg-1">
        <div class="co-detail-card shadow-sm p-4">
          <form action="/checkout" method="POST" id="checkout-form">
            <h5 class="font-serif fw-bold mb-4">Thông tin giao hàng</h5>
            
            <div class="mb-4">
              <label for="email" class="form-label fw-semibold text-muted small">Email nhận thông báo:</label>
              <div class="input-group">
                <span class="input-group-text bg-white border-end-0" style="border: 1.5px solid rgba(92, 62, 53, 0.12); color: var(--co-primary);"><i class="bi bi-envelope"></i></span>
                <input type="email" name="email" id="email" class="form-control co-form-control border-start-0" required placeholder="example@gmail.com" value="<%= user ? user.email : '' %>">
              </div>
            </div>

            <h5 class="font-serif fw-bold mb-3 mt-4">Phương thức thanh toán</h5>
            <div class="payment-methods mb-4">
              <label class="d-block p-3 border rounded-3 mb-3 cursor-pointer transition" style="cursor: pointer; border: 1.5px solid rgba(92, 62, 53, 0.1); hover: border-color: var(--co-primary);">
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="paymentMethod" value="cash" id="cash" checked>
                  <label class="form-check-label fw-bold" for="cash">Thanh toán tiền mặt (COD)</label>
                  <p class="text-muted small m-0">Thanh toán trực tiếp khi nhận hàng.</p>
                </div>
              </label>

              <label class="d-block p-3 border rounded-3 cursor-pointer transition" style="cursor: pointer; border: 1.5px solid rgba(92, 62, 53, 0.1); hover: border-color: var(--co-primary);">
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="paymentMethod" value="vnpay" id="vnpay">
                  <label class="form-check-label fw-bold" for="vnpay">Cổng thanh toán PayOS</label>
                  <p class="text-muted small m-0">Thẻ nội địa, QR Code ngân hàng (Nhanh chóng & Bảo mật).</p>
                </div>
              </label>
            </div>

            <button type="submit" class="co-btn co-btn-primary w-100 py-3 text-uppercase fw-bold shadow-sm">
              <i class="bi bi-check2-circle me-2"></i> Hoàn tất đặt hàng
            </button>
          </form>
        </div>
      </div>
    </div>
  </main>

  <footer class="co-footer mt-5">
    <div class="container text-center">
      <p class="m-0 text-white-50 small">&copy; 2026 Coffee Store. Tất cả quyền được bảo lưu.</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
