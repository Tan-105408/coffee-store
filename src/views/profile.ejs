<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hồ sơ - Coffee Store</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="d-flex flex-column min-vh-100">
  <%- include('partials/navbar') %>

  <main class="container flex-grow-1 py-5">
    <div class="row g-4">
      <!-- Sidebar -->
      <div class="col-lg-4">
        <div class="profile-card p-4 text-center">
          <div class="d-inline-flex align-items-center justify-content-center rounded-circle shadow-sm mb-3" style="width:90px;height:90px;background:linear-gradient(135deg, var(--co-primary), var(--co-secondary));">
            <i class="bi bi-person-fill text-white" style="font-size:2.5rem;"></i>
          </div>
          <h4 class="font-serif fw-bold mb-1"><%= user.username %></h4>
          <p class="small mb-3" style="color:var(--co-text-muted);"><%= user.email %></p>
          <span class="badge px-3 py-2" style="background:<%= user.role === 'admin' ? 'var(--co-primary-dark)' : 'var(--co-primary-light)' %>;color:#fff;">
            <i class="bi bi-shield-check me-1"></i><%= user.role === 'admin' ? 'Quản trị viên' : 'Thành viên' %>
          </span>
          <hr class="my-4" style="border-color:var(--co-border);">
          <div class="text-start">
            <div class="d-flex align-items-center mb-3">
              <div class="me-3" style="width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:rgba(61,139,110,0.1);color:var(--co-success);font-size:1.1rem;"><i class="bi bi-calendar-check"></i></div>
              <div>
                <small class="d-block" style="color:var(--co-text-muted);">Ngày tham gia</small>
                <strong><%= new Date(user.createdAt).toLocaleDateString('vi-VN') %></strong>
              </div>
            </div>
            <div class="d-flex align-items-center">
              <div class="me-3" style="width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:rgba(200,149,108,0.12);color:var(--co-secondary);font-size:1.1rem;"><i class="bi bi-geo-alt"></i></div>
              <div>
                <small class="d-block" style="color:var(--co-text-muted);">Địa chỉ</small>
                <strong><%= user.address || 'Chưa cập nhật' %></strong>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Content -->
      <div class="col-lg-8">
        <div class="profile-card">
          <ul class="nav nav-tabs profile-tabs px-3 pt-3" role="tablist">
            <li class="nav-item">
              <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#profileInfo">
                <i class="bi bi-person-lines-fill me-2"></i>Thông tin cá nhân
              </button>
            </li>
            <li class="nav-item">
              <button class="nav-link" data-bs-toggle="tab" data-bs-target="#security">
                <i class="bi bi-shield-lock me-2"></i>Bảo mật
              </button>
            </li>
          </ul>

          <div class="tab-content p-4">
            <!-- Profile Info -->
            <div class="tab-pane fade show active" id="profileInfo">
              <form id="profile-form">
                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label fw-semibold small" style="color:var(--co-text-muted);">Tên đăng nhập</label>
                    <div class="input-group">
                      <span class="input-group-text bg-white border-end-0"><i class="bi bi-person"></i></span>
                      <input type="text" name="username" class="form-control co-form-control border-start-0" value="<%= user.username %>" required>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold small" style="color:var(--co-text-muted);">Email</label>
                    <div class="input-group">
                      <span class="input-group-text bg-white border-end-0"><i class="bi bi-envelope"></i></span>
                      <input type="email" name="email" class="form-control co-form-control border-start-0" value="<%= user.email %>" required>
                    </div>
                  </div>
                  <div class="col-12">
                    <label class="form-label fw-semibold small" style="color:var(--co-text-muted);">Địa chỉ giao hàng</label>
                    <div class="input-group">
                      <span class="input-group-text bg-white border-end-0"><i class="bi bi-geo-alt"></i></span>
                      <input type="text" name="address" class="form-control co-form-control border-start-0" value="<%= user.address || '' %>" placeholder="Nhập địa chỉ giao hàng">
                    </div>
                  </div>
                  <div class="col-12 mt-4">
                    <button type="submit" class="co-btn co-btn-primary px-4">
                      <i class="bi bi-check-circle me-1"></i> Lưu thay đổi
                    </button>
                  </div>
                </div>
              </form>
            </div>

            <!-- Security -->
            <div class="tab-pane fade" id="security">
              <div class="alert alert-info d-flex align-items-center" style="border-radius:var(--co-radius-sm);border-color:rgba(61,139,110,0.15);background:rgba(61,139,110,0.06);color:var(--co-text);">
                <i class="bi bi-info-circle me-2" style="color:var(--co-success);"></i>
                <small>Để thay đổi mật khẩu, vui lòng liên hệ hỗ trợ hoặc sử dụng chức năng quên mật khẩu.</small>
              </div>
              <div class="p-4" style="background:var(--co-bg);border-radius:var(--co-radius);">
                <h6 class="fw-bold mb-3"><i class="bi bi-google me-2"></i>Tài khoản Google</h6>
                <% if (user.googleId) { %>
                  <div class="d-flex align-items-center" style="color:var(--co-success);">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <span>Đã liên kết tài khoản Google</span>
                  </div>
                <% } else { %>
                  <div class="d-flex align-items-center" style="color:var(--co-text-muted);">
                    <i class="bi bi-x-circle me-2"></i>
                    <span>Chưa liên kết</span>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-4">
          <a href="/" class="co-btn co-btn-secondary px-4"><i class="bi bi-arrow-left"></i> Quay về trang chủ</a>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.getElementById("profile-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData);
      const btn = e.target.querySelector('button[type="submit"]');
      const originalText = btn.innerHTML;

      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang lưu...';

      try {
        const response = await fetch("/auth/profile/update", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data)
        });
        const result = await response.json();

        if (response.ok) {
          Swal.fire({ text: result.message || "Cập nhật thành công!", icon: 'success', confirmButtonColor: '#4A2C2A' });
        } else {
          Swal.fire({ text: result.message || "Có lỗi xảy ra!", icon: 'error', confirmButtonColor: '#4A2C2A' });
        }
      } catch (error) {
        Swal.fire({ text: "Lỗi kết nối!", icon: 'error', confirmButtonColor: '#4A2C2A' });
      } finally {
        btn.disabled = false;
        btn.innerHTML = originalText;
      }
    });
  </script>
  <script src="/client-logger.js"></script>
</body>
</html>
