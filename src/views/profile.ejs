<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hồ sơ người dùng - Coffee Store</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <!-- SweetAlert2 -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/style.css">
  <style>
    .profile-tabs .nav-link { border: none; color: #6c757d; font-weight: 500; padding: 12px 20px; border-radius: 10px; transition: all 0.3s; }
    .profile-tabs .nav-link:hover { background: #f8f9fa; color: var(--co-primary); }
    .profile-tabs .nav-link.active { background: var(--co-primary); color: #fff; }
    .profile-card { border: none; border-radius: 16px; box-shadow: 0 8px 30px rgba(0,0,0,0.08); }
    .info-icon { width: 45px; height: 45px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; }
  </style>
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
  <!-- Header / Navbar -->
  <header>
    <nav class="navbar navbar-expand-lg co-navbar navbar-dark sticky-top">
      <div class="container">
        <a class="navbar-brand d-flex align-items-center" href="/">
          <span class="fs-3 me-2">☕</span>
          <span class="font-serif fw-bold">Coffee Store</span>
        </a>
        <div class="navbar-nav ms-auto d-flex align-items-center gap-3">
          <a class="nav-link" href="/"><i class="bi bi-house-door me-1"></i> Trang chủ</a>
          <a class="nav-link" href="/cart"><i class="bi bi-cart3 me-1"></i> Giỏ hàng</a>
          <span class="text-white-50 small d-none d-sm-inline">👋 <%= user.username %></span>
          <a href="/auth/logout" class="co-btn co-btn-accent px-3 py-1.5 btn-sm"><i class="bi bi-box-arrow-right me-1"></i> Đăng xuất</a>
        </div>
      </div>
    </nav>
  </header>

  <!-- Profile Dashboard Panel -->
  <main class="container flex-grow-1 py-5">
    <div class="row g-4">
      <!-- Sidebar Info -->
      <div class="col-lg-4">
        <div class="card profile-card p-4 text-center">
          <div class="d-inline-flex align-items-center justify-content-center rounded-circle shadow-sm mb-3" style="width: 90px; height: 90px; background: linear-gradient(135deg, var(--co-primary), var(--co-secondary));">
            <i class="bi bi-person-fill text-white" style="font-size: 2.5rem;"></i>
          </div>
          <h4 class="font-serif fw-bold mb-1"><%= user.username %></h4>
          <p class="text-muted small mb-3"><%= user.email %></p>
          <span class="badge <%= user.role === 'admin' ? 'bg-dark' : 'bg-secondary' %> px-3 py-2">
            <i class="bi bi-shield-check me-1"></i><%= user.role === 'admin' ? 'Quản trị viên' : 'Thành viên' %>
          </span>
          <hr class="my-4">
          <div class="text-start">
            <div class="d-flex align-items-center mb-3">
              <div class="info-icon me-3" style="background: #e3f2fd; color: #1976d2;"><i class="bi bi-calendar-check"></i></div>
              <div>
                <small class="text-muted d-block">Ngày tham gia</small>
                <strong><%= new Date(user.createdAt).toLocaleDateString('vi-VN') %></strong>
              </div>
            </div>
            <div class="d-flex align-items-center">
              <div class="info-icon me-3" style="background: #e8f5e9; color: #388e3c;"><i class="bi bi-geo-alt"></i></div>
              <div>
                <small class="text-muted d-block">Địa chỉ</small>
                <strong><%= user.address || 'Chưa cập nhật' %></strong>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Content -->
      <div class="col-lg-8">
        <div class="card profile-card">
          <!-- Tabs -->
          <ul class="nav nav-tabs profile-tabs px-3 pt-3" role="tablist">
            <li class="nav-item">
              <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#profileInfo">
                <i class="bi bi-person-lines-fill me-2"></i>Thông tin cá nhân
              </button>
            </li>
            <li class="nav-item">
              <button class="nav-link" data-bs-toggle="tab" data-bs-target="#security">
                <i class="bi bi-shield-lock me-2"></i>Bảo mật
              </button>
            </li>
          </ul>

          <!-- Tab Content -->
          <div class="tab-content p-4">
            <!-- Profile Info Tab -->
            <div class="tab-pane fade show active" id="profileInfo">
              <form id="profile-form">
                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label fw-semibold small text-muted">Tên đăng nhập</label>
                    <div class="input-group">
                      <span class="input-group-text bg-white border-end-0" style="border: 1.5px solid rgba(92, 62, 53, 0.12); color: var(--co-primary);"><i class="bi bi-person"></i></span>
                      <input type="text" name="username" class="form-control co-form-control border-start-0" value="<%= user.username %>" required>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label fw-semibold small text-muted">Địa chỉ Email</label>
                    <div class="input-group">
                      <span class="input-group-text bg-white border-end-0" style="border: 1.5px solid rgba(92, 62, 53, 0.12); color: var(--co-primary);"><i class="bi bi-envelope"></i></span>
                      <input type="email" name="email" class="form-control co-form-control border-start-0" value="<%= user.email %>" required>
                    </div>
                  </div>

                  <div class="col-12">
                    <label class="form-label fw-semibold small text-muted">Địa chỉ giao hàng</label>
                    <div class="input-group">
                      <span class="input-group-text bg-white border-end-0" style="border: 1.5px solid rgba(92, 62, 53, 0.12); color: var(--co-primary);"><i class="bi bi-geo-alt"></i></span>
                      <input type="text" name="address" class="form-control co-form-control border-start-0" value="<%= user.address || '' %>" placeholder="Nhập địa chỉ giao hàng chi tiết của bạn">
                    </div>
                  </div>

                  <div class="col-12 mt-4">
                    <button type="submit" class="co-btn co-btn-primary px-4">
                      <i class="bi bi-check-circle me-1"></i> Lưu thay đổi
                    </button>
                  </div>
                </div>
              </form>
            </div>

            <!-- Security Tab -->
            <div class="tab-pane fade" id="security">
              <div class="alert alert-info d-flex align-items-center">
                <i class="bi bi-info-circle me-2"></i>
                <small>Để thay đổi mật khẩu, vui lòng liên hệ hỗ trợ hoặc sử dụng chức năng quên mật khẩu.</small>
              </div>
              <div class="row g-3">
                <div class="col-12">
                  <div class="p-4 rounded-3" style="background: #f8f9fa;">
                    <h6 class="fw-bold mb-3"><i class="bi bi-google me-2"></i>Tài khoản Google</h6>
                    <% if (user.googleId) { %>
                      <div class="d-flex align-items-center text-success">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        <span>Đã liên kết tài khoản Google</span>
                      </div>
                    <% } else { %>
                      <div class="d-flex align-items-center text-muted">
                        <i class="bi bi-x-circle me-2"></i>
                        <span>Chưa liên kết</span>
                      </div>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Back Button -->
        <div class="mt-4">
          <a href="/" class="co-btn co-btn-secondary px-4">
            <i class="bi bi-arrow-left"></i> Quay về trang chủ
          </a>
        </div>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="co-footer py-4 mt-0 rounded-0">
    <div class="container text-center">
      <p class="m-0 text-white-50 small">&copy; 2026 Coffee Store. Tất cả quyền được bảo lưu.</p>
    </div>
  </footer>

  <!-- Bootstrap 5 JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Form Handle Script -->
  <script>
    document.getElementById("profile-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData);
      const btn = e.target.querySelector('button[type="submit"]');
      const originalText = btn.innerHTML;

      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang lưu...';

      try {
        const response = await fetch("/auth/profile/update", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data)
        });
        const result = await response.json();

        if (response.ok) {
          Swal.fire({
            text: result.message || "Cập nhật hồ sơ thành công!",
            icon: 'success',
            confirmButtonColor: '#5c3e35'
          });
        } else {
          Swal.fire({
            text: result.message || "Có lỗi xảy ra!",
            icon: 'error',
            confirmButtonColor: '#e76f51'
          });
        }
      } catch (error) {
        Swal.fire({
          text: "Lỗi kết nối!",
          icon: 'error',
          confirmButtonColor: '#e76f51'
        });
      } finally {
        btn.disabled = false;
        btn.innerHTML = originalText;
      }
    });
  </script>
</body>
</html>