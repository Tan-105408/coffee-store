<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đặt hàng thành công - Coffee Store</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body class="d-flex flex-column min-vh-100">
  <%- include('partials/navbar') %>

  <main class="container flex-grow-1 d-flex align-items-center justify-content-center py-5">
    <div class="co-detail-card text-center p-5 success-animation" style="max-width:550px;">
      <div class="co-status-circle success mx-auto mb-4">
        <i class="bi bi-check-lg text-white" style="font-size:3.5rem;"></i>
      </div>
      <h2 class="font-serif fw-bold mb-3" style="color:var(--co-text);">Đặt hàng thành công!</h2>
      <p class="mb-4" style="color:var(--co-text-muted);">Cảm ơn bạn đã tin tưởng Coffee Store. Đơn hàng đang được xử lý.</p>

      <div class="p-3 mb-4" style="background:var(--co-bg);border-radius:var(--co-radius);border:1px dashed var(--co-border-strong);">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="small" style="color:var(--co-text-muted);"><i class="bi bi-credit-card me-2"></i>Mã giao dịch</span>
          <span class="fw-semibold" style="color:var(--co-text);"><%= transactionId %></span>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="small" style="color:var(--co-text-muted);"><i class="bi bi-clock me-2"></i>Thời gian đặt</span>
          <span class="fw-semibold" style="color:var(--co-text);"><%= orderTime %></span>
        </div>
        <div class="d-flex justify-content-between align-items-center">
          <span class="small" style="color:var(--co-text-muted);"><i class="bi bi-truck me-2"></i>Dự kiến giao</span>
          <span class="fw-semibold" style="color:var(--co-text);">15-30 phút</span>
        </div>
      </div>

      <div class="d-flex gap-3 justify-content-center">
        <a href="/order/history" class="co-btn co-btn-secondary px-4 py-3 fw-bold">
          <i class="bi bi-bag-check me-2"></i> Xem đơn hàng
        </a>
        <a href="/" class="co-btn co-btn-primary px-4 py-3 fw-bold shadow">
          <i class="bi bi-shop me-2"></i> Tiếp tục mua sắm
        </a>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script src="/client-logger.js"></script>
</body>
</html>
