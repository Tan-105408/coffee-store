<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đặt hàng thành công - Coffee Store</title>
  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/style.css">
  <style>
    .success-animation { animation: bounceIn 0.8s ease-out; }
    @keyframes bounceIn {
      0% { transform: scale(0); opacity: 0; }
      50% { transform: scale(1.2); }
      100% { transform: scale(1); opacity: 1; }
    }
    .success-circle {
      width: 120px; height: 120px;
      background: linear-gradient(135deg, #2a9d8f, #52c4b8);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 10px 40px rgba(42, 157, 143, 0.3);
    }
    .order-box {
      border: 2px dashed rgba(42, 157, 143, 0.3);
      border-radius: 16px;
      background: linear-gradient(to bottom, #f8fdfc, #fff);
    }
  </style>
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
  <!-- Header -->
  <header>
    <nav class="navbar navbar-expand-lg co-navbar navbar-dark sticky-top">
      <div class="container">
        <a class="navbar-brand d-flex align-items-center" href="/">
          <span class="fs-3 me-2">☕</span>
          <span class="font-serif fw-bold">Coffee Store</span>
        </a>
      </div>
    </nav>
  </header>

  <main class="container flex-grow-1 d-flex align-items-center justify-content-center py-5">
    <div class="co-detail-card shadow-lg text-center p-5 rounded-4 success-animation" style="max-width: 550px;">
      <div class="success-circle mx-auto mb-4">
        <i class="bi bi-check-lg text-white" style="font-size: 4rem;"></i>
      </div>
      <h2 class="font-serif fw-bold text-dark mb-3">Đặt hàng thành công!</h2>
      <p class="text-muted mb-4">Cảm ơn bạn đã tin tưởng Coffee Store. Đơn hàng của bạn đang được xử lý.</p>

      <div class="order-box p-4 mb-4 text-start">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <span class="text-muted small"><i class="bi bi-receipt me-2"></i>Mã đơn hàng</span>
          <span class="fw-bold text-success">#<%= Math.floor(Math.random() * 900000) + 100000 %></span>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-3">
          <span class="text-muted small"><i class="bi bi-clock me-2"></i>Thời gian đặt</span>
          <span class="fw-semibold"><%= new Date().toLocaleString('vi-VN') %></span>
        </div>
        <div class="d-flex justify-content-between align-items-center">
          <span class="text-muted small"><i class="bi bi-truck me-2"></i>Dự kiến giao</span>
          <span class="fw-semibold">15-30 phút</span>
        </div>
      </div>

      <a href="/" class="co-btn co-btn-primary px-5 py-3 fw-bold shadow">
        <i class="bi bi-shop me-2"></i> Tiếp tục mua sắm
      </a>
    </div>
  </main>

  <footer class="co-footer mt-5">
    <div class="container text-center">
      <p class="m-0 text-white-50 small">&copy; 2026 Coffee Store. Tất cả quyền được bảo lưu.</p>
    </div>
  </footer>
</body>
</html>