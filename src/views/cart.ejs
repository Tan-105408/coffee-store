<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giỏ hàng - Coffee Store</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body class="d-flex flex-column min-vh-100">
    <%- include('partials/navbar', { activePage: 'cart' }) %>

    <main class="container flex-grow-1 py-5">
      <div class="d-flex align-items-center mb-4 gap-3">
        <h2 class="font-serif fw-bold m-0"><i class="bi bi-cart3 me-2"></i> Giỏ hàng</h2>
        <% if (cart && Array.isArray(cart) && cart.length > 0) { %>
          <span class="badge px-3 py-2" style="background:var(--co-bg);color:var(--co-text-secondary);border:1px solid var(--co-border-strong);"><%= cart.length %> sản phẩm</span>
        <% } %>
      </div>

      <% if (cart && Array.isArray(cart) && cart.length > 0) {%>
        <div class="row g-4">
          <!-- Table -->
          <div class="col-lg-8">
            <div class="co-cart-table">
              <table class="table align-middle m-0">
                <thead>
                  <tr>
                    <th class="ps-4">Sản phẩm</th>
                    <th>Đơn giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                    <th class="text-center"><i class="bi bi-trash"></i></th>
                  </tr>
                </thead>
                <tbody>
                  <% cart && Array.isArray(cart) && cart.forEach(item => { %>
                    <tr>
                      <td class="ps-4">
                        <div class="d-flex align-items-center gap-3">
                          <img src="<%= item.product.image %>" alt="<%= item.product.name %>" style="width:64px;height:64px;object-fit:cover;border-radius:var(--co-radius-sm);" />
                          <div>
                            <span class="fw-semibold d-block" style="color:var(--co-text);"><%= item.product.name %></span>
                            <% if (item.options) { %>
                              <small style="color:var(--co-text-muted);">
                                <% if (item.options.ice) { %><span class="badge me-1" style="background:var(--co-bg);color:var(--co-text-secondary);border:1px solid var(--co-border);"><i class="bi bi-snow2 me-1"></i><%= item.options.ice %></span><% } %>
                                <% if (item.options.sugar) { %><span class="badge me-1" style="background:var(--co-bg);color:var(--co-text-secondary);border:1px solid var(--co-border);"><i class="bi bi-droplet me-1"></i><%= item.options.sugar %></span><% } %>
                                <% if (item.options.toppings && item.options.toppings.length > 0) { %>
                                  <% item.options.toppings.forEach(function(t) { %>
                                    <span class="badge me-1" style="background:rgba(61,139,110,0.08);color:var(--co-success);border:1px solid rgba(61,139,110,0.15);"><i class="bi bi-plus-circle me-1"></i><%= t.name %></span>
                                  <% }); %>
                                <% } %>
                              </small>
                            <% } %>
                          </div>
                        </div>
                      </td>
                      <td>
                        <div class="fw-bold" style="color:var(--co-text);">
                          <%= item.priceAfterDiscount ? item.priceAfterDiscount.toLocaleString() : item.product.price.toLocaleString() %>đ
                        </div>
                        <% if (item.product.discount > 0) { %>
                          <small class="text-decoration-line-through" style="color:var(--co-text-muted);"><%= item.product.price.toLocaleString() %>đ</small>
                        <% } %>
                      </td>
                      <td>
                        <div class="d-flex align-items-center gap-2">
                          <button class="btn btn-sm btn-outline-secondary qty-btn" data-action="decrease" data-id="<%= item.product.id %>"><i class="bi bi-dash"></i></button>
                          <span class="badge px-3 py-2 fw-bold" style="background:var(--co-bg);color:var(--co-text);border:1px solid var(--co-border);"><%= item.quantity %></span>
                          <button class="btn btn-sm btn-outline-secondary qty-btn" data-action="increase" data-id="<%= item.product.id %>"><i class="bi bi-plus"></i></button>
                        </div>
                      </td>
                      <td class="fw-bold" style="color:var(--co-accent);"><%= item.total.toLocaleString() %>đ</td>
                      <td class="text-center">
                        <button class="btn btn-sm remove-item" style="color:var(--co-danger);" data-id="<%= item.product.id %>" title="Xóa">
                          <i class="bi bi-trash"></i>
                        </button>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Summary -->
          <div class="col-lg-4">
            <div class="co-summary-card sticky-top" style="top:100px;">
              <h4 class="font-serif fw-bold mb-4">Tổng quan</h4>
              <div class="d-flex justify-content-between mb-3">
                <span style="color:var(--co-text-muted);">Tạm tính:</span>
                <span class="fw-bold" style="color:var(--co-text);"><%= total.toLocaleString() %>đ</span>
              </div>
              <div class="d-flex justify-content-between mb-4 border-top pt-3" style="border-color:var(--co-border) !important;">
                <span class="fw-bold fs-5">Tổng cộng:</span>
                <span class="fw-bold fs-4" style="color:var(--co-success);"><%= total.toLocaleString() %>đ</span>
              </div>
              <a href="/checkout" class="co-btn co-btn-primary w-100 py-3 text-uppercase fw-bold shadow-sm">
                <i class="bi bi-credit-card me-2"></i> Thanh toán
              </a>
              <a href="/" class="co-btn co-btn-secondary w-100 mt-3 py-2 text-decoration-none">
                <i class="bi bi-arrow-left me-2"></i> Tiếp tục mua sắm
              </a>
            </div>
          </div>
        </div>
      <% } else { %>
        <!-- Empty Cart -->
        <div class="co-empty-state">
          <i class="bi bi-cart-x text-co-muted" style="font-size:4rem;"></i>
          <h4 class="mt-4 font-serif fw-bold">Giỏ hàng trống!</h4>
          <p style="color:var(--co-text-muted);" class="mb-4">Khám phá thực đơn và đặt hàng ngay.</p>
          <a href="/" class="co-btn co-btn-primary px-4 py-2">
            <i class="bi bi-shop me-2"></i> Mua sắm ngay
          </a>
        </div>
      <% } %>
    </main>

    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/script.js"></script>
    <script>
      document.querySelectorAll('.qty-btn').forEach(btn => {
        btn.addEventListener('click', async function() {
          const productId = this.dataset.id;
          const action = this.dataset.action;
          try {
            const response = await fetch('/cart/update', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ productId, action })
            });
            if (response.ok) {
              location.reload();
            } else {
              const data = await response.json();
              Swal.fire({ icon: 'error', text: data.message || 'Lỗi cập nhật giỏ hàng' });
            }
          } catch (error) { console.error('Error:', error); }
        });
      });
    </script>
    <script src="/client-logger.js"></script>
  </body>
</html>
