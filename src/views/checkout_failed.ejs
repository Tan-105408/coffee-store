<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Thanh toán bị hủy - Coffee Store</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body class="d-flex flex-column min-vh-100">
  <%- include('partials/navbar') %>

  <main class="container flex-grow-1 d-flex align-items-center justify-content-center py-5">
    <div class="co-detail-card text-center p-5 cancel-animation" style="max-width:550px;">
      <div class="co-status-circle cancel mx-auto mb-4">
        <i class="bi bi-x-lg text-white" style="font-size:3.5rem;"></i>
      </div>
      <h2 class="font-serif fw-bold mb-3" style="color:var(--co-text);">Thanh toán đã bị hủy</h2>
      <p class="mb-4" style="color:var(--co-text-muted);"><%= typeof message !== 'undefined' ? message : 'Giao dịch đã bị hủy hoặc gặp sự cố. Bạn có thể thử lại.' %></p>

      <div class="p-4 mb-4 text-start" style="border:1px solid rgba(212,102,60,0.2);border-radius:var(--co-radius);background:rgba(250,247,242,0.5);">
        <h6 class="fw-bold mb-3" style="color:var(--co-accent);"><i class="bi bi-lightbulb me-2"></i>Gợi ý</h6>
        <ul class="list-unstyled mb-0">
          <li class="mb-2"><i class="bi bi-check2 me-2" style="color:var(--co-success);"></i>Kiểm tra kết nối internet</li>
          <li class="mb-2"><i class="bi bi-check2 me-2" style="color:var(--co-success);"></i>Thử phương thức thanh toán khác</li>
          <li class="mb-0"><i class="bi bi-check2 me-2" style="color:var(--co-success);"></i>Liên hệ hỗ trợ nếu cần</li>
        </ul>
      </div>

      <div class="d-flex gap-3 justify-content-center flex-wrap">
        <a href="/cart" class="co-btn co-btn-secondary px-4 py-3 fw-bold">
          <i class="bi bi-cart3 me-2"></i> Về giỏ hàng
        </a>
        <a href="/" class="co-btn co-btn-primary px-4 py-3 fw-bold">
          <i class="bi bi-shop me-2"></i> Menu
        </a>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script src="/client-logger.js"></script>
</body>
</html>
