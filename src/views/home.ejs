<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Coffee Store - Xưởng Cà Phê Thủ Công</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <%- include('partials/navbar') %>

    <!-- Hero Section with Slider -->
    <section class="co-hero-slider">
      <div class="co-hero-slides">
        <div class="co-hero-slide active" style="background-image: url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1600&q=80');">
          <div class="container py-4" style="position:relative; z-index:2;">
            <span class="co-section-eyebrow mb-3 d-block" style="color:var(--co-secondary);">Xưởng Cà Phê Thủ Công</span>
            <h1>Hương vị nồng nàn,<br><em>khởi đầu ngày mới</em></h1>
            <p class="hero-subtitle">Bộ sưu tập cà phê nguyên chất, trà hảo hạng và bánh ngọt tuyển chọn.</p>
            <a href="#menu" class="co-btn co-btn-accent co-btn-lg">
              <i class="bi bi-cup-hot me-2"></i> Xem thực đơn
            </a>
          </div>
        </div>
        <div class="co-hero-slide" style="background-image: url('https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?auto=format&fit=crop&w=1600&q=80');">
          <div class="container py-4" style="position:relative; z-index:2;">
            <span class="co-section-eyebrow mb-3 d-block" style="color:var(--co-secondary);">Trà & Sinh Tố</span>
            <h1>Thức uống<br><em>tươi mát mỗi ngày</em></h1>
            <p class="hero-subtitle">Trà trái cây, sinh tố và nước ép tươi ngon từ nguyên liệu tự nhiên.</p>
            <a href="/?category=Trà trái cây" class="co-btn co-btn-accent co-btn-lg">
              <i class="bi bi-cup-straw me-2"></i> Khám phá ngay
            </a>
          </div>
        </div>
        <div class="co-hero-slide" style="background-image: url('https://images.unsplash.com/photo-1486427944544-d2c246c4df14?auto=format&fit=crop&w=1600&q=80');">
          <div class="container py-4" style="position:relative; z-index:2;">
            <span class="co-section-eyebrow mb-3 d-block" style="color:var(--co-secondary);">Khuyến Mãi</span>
            <h1>Giảm giá<br><em>lên đến 30%</em></h1>
            <p class="hero-subtitle">Ưu đãi đặc biệt cho mùa hè. Đừng bỏ lỡ!</p>
            <a href="#menu" class="co-btn co-btn-accent co-btn-lg">
              <i class="bi bi-tags me-2"></i> Mua ngay
            </a>
          </div>
        </div>
      </div>
      <div class="co-hero-nav">
        <button class="co-hero-nav-btn" id="heroPrev"><i class="bi bi-chevron-left"></i></button>
        <div class="co-hero-dots">
          <span class="co-hero-dot active" data-index="0"></span>
          <span class="co-hero-dot" data-index="1"></span>
          <span class="co-hero-dot" data-index="2"></span>
        </div>
        <button class="co-hero-nav-btn" id="heroNext"><i class="bi bi-chevron-right"></i></button>
      </div>
    </section>

    <!-- Category Scrolling Bar -->
    <section class="co-category-scroll-bar">
      <div class="container">
        <div class="co-category-scroll">
          <a href="/" class="co-category-scroll-item active">
            <div class="co-category-scroll-icon"><i class="bi bi-grid-3x3-gap"></i></div>
            <span>Tất cả</span>
          </a>
          <a href="/?category=Cà%20phê" class="co-category-scroll-item">
            <div class="co-category-scroll-icon"><i class="bi bi-cup-hot"></i></div>
            <span>Cà phê</span>
          </a>
          <a href="/?category=Trà%20trái%20cây" class="co-category-scroll-item">
            <div class="co-category-scroll-icon"><i class="bi bi-cup-straw"></i></div>
            <span>Trà trái cây</span>
          </a>
          <a href="/?category=Trà%20sữa" class="co-category-scroll-item">
            <div class="co-category-scroll-icon"><i class="bi bi-droplet"></i></div>
            <span>Trà sữa</span>
          </a>
          <a href="/?category=Sinh%20tố" class="co-category-scroll-item">
            <div class="co-category-scroll-icon"><i class="bi bi-droplets"></i></div>
            <span>Sinh tố</span>
          </a>
          <a href="/?category=Nước%20ép" class="co-category-scroll-item">
            <div class="co-category-scroll-icon"><i class="bi bi-cup"></i></div>
            <span>Nước ép</span>
          </a>
          <a href="/?category=Bánh%20ngọt" class="co-category-scroll-item">
            <div class="co-category-scroll-icon"><i class="bi bi-cake"></i></div>
            <span>Bánh ngọt</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Main Content -->
    <main class="container mb-5 position-relative" id="menu">

      <!-- Best Sellers -->
      <% if (bestSellers && bestSellers.length > 0) { %>
      <section class="mb-5 pt-4">
        <div class="d-flex align-items-center mb-4">
          <div class="co-best-seller-badge me-3"><i class="bi bi-star-fill"></i></div>
          <div>
            <span class="co-section-eyebrow">Được yêu thích nhất</span>
            <h2 class="font-serif fw-bold mb-0 mt-1" style="font-size:1.7rem;">Best Seller</h2>
          </div>
        </div>
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
          <% bestSellers.forEach(product => { %>
            <div class="col">
              <div class="co-product-card co-product-card-mini">
                <div class="co-product-img-wrapper">
                  <% if (product.discount > 0) { %>
                    <div class="co-discount-badge">-<%= product.discount %>%</div>
                  <% } %>
                  <img src="<%= product.image %>" alt="<%= product.name %>" class="co-product-img" loading="lazy" />
                </div>
                <div class="co-product-body">
                  <span class="co-product-category"><%= product.category %></span>
                  <h3 class="co-product-title"><%= product.name %></h3>
                  <div class="co-rating-display d-flex align-items-center gap-1 mb-2">
                    <%
                      const avgR = product.avgRating || 0;
                      const rc = product.reviewCount || 0;
                      const fs = Math.floor(avgR);
                      const hs = avgR - fs >= 0.5;
                      const es = 5 - fs - (hs ? 1 : 0);
                    %>
                    <% for (let i = 0; i < fs; i++) { %>
                      <i class="bi bi-star-fill text-warning"></i>
                    <% } %>
                    <% if (hs) { %>
                      <i class="bi bi-star-half text-warning"></i>
                    <% } %>
                    <% for (let i = 0; i < es; i++) { %>
                      <i class="bi bi-star text-muted"></i>
                    <% } %>
                    <% if (rc > 0) { %>
                      <span class="text-muted small">(<%= rc %>)</span>
                    <% } %>
                  </div>
                  <% if (product.soldCount && product.soldCount > 0) { %>
                    <div class="co-sold-count d-flex align-items-center gap-1 mb-2" style="color:var(--co-text-muted);font-size:0.75rem;">
                      <i class="bi bi-check2-all"></i> <span>Đã bán: <strong><%= product.soldCount.toLocaleString() %></strong></span>
                    </div>
                  <% } %>
                  <div class="co-price-row">
                    <% if (product.discount > 0) { %>
                      <span class="co-price-original"><%= product.price.toLocaleString() %>đ</span>
                      <span class="co-price-current"><%= (product.price * (1 - product.discount / 100)).toLocaleString() %>đ</span>
                    <% } else { %>
                      <span class="co-price-current"><%= product.price.toLocaleString() %>đ</span>
                    <% } %>
                  </div>
                  <div class="d-flex gap-2 flex-nowrap">
                    <a href="/api/products/<%= product.id %>" class="co-btn co-btn-secondary co-btn-sm flex-fill text-decoration-none text-center">
                      <i class="bi bi-eye me-1"></i> Chi tiết
                    </a>
                    <button class="co-btn co-btn-primary co-btn-sm add-to-cart flex-fill" data-id="<%= product.id %>">
                      <i class="bi bi-cart-plus"></i> Mua ngay
                    </button>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </section>
      <% } %>

      <!-- Promo Banners -->
      <% if (promoProducts && promoProducts.length > 0) { %>
      <% promoProducts.forEach(promo => { %>
        <section class="mb-4 mt-3">
          <div class="co-promo-banner">
            <div class="row align-items-center g-0" style="min-height:200px;">
              <div class="col-md-7 p-4 p-md-5 text-white position-relative" style="z-index:2;">
                <span class="badge mb-3 px-3 py-2" style="background:var(--co-secondary);color:var(--co-primary-dark);font-size:0.72rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;">
                  <i class="bi bi-star-fill me-1"></i> <%= promo.promoTag === 'coffee-for-life' ? 'Đặc biệt' : 'Khuyến mãi' %>
                </span>
                <h2 class="font-serif fw-bold mb-2" style="font-size:1.7rem;"><%= promo.name %></h2>
                <p class="mb-3 opacity-85 small" style="max-width:400px;"><%= promo.description || 'Sản phẩm đặc biệt từ Coffee Store' %></p>
                <div class="d-flex align-items-center gap-3 mb-3">
                  <% if (promo.discount > 0) { %>
                    <span class="text-decoration-line-through opacity-50"><%= promo.price.toLocaleString() %>đ</span>
                    <span class="fw-bold fs-4"><%= (promo.price * (1 - promo.discount / 100)).toLocaleString() %>đ</span>
                  <% } else { %>
                    <span class="fw-bold fs-4"><%= promo.price.toLocaleString() %>đ</span>
                  <% } %>
                </div>
                <a href="/api/products/<%= promo.id %>" class="co-btn co-btn-accent px-4 py-2 text-decoration-none">
                  <i class="bi bi-cart-plus-fill me-1"></i> Đặt ngay
                </a>
              </div>
              <div class="col-md-5 d-none d-md-block position-relative">
                <img src="<%= promo.image %>" alt="<%= promo.name %>" style="width:100%;height:200px;object-fit:cover;border-radius:0 var(--co-radius-xl) var(--co-radius-xl) 0;" />
                <div style="position:absolute;inset:0;background:linear-gradient(90deg, var(--co-primary-dark) 0%, transparent 40%);"></div>
              </div>
            </div>
          </div>
        </section>
      <% }) %>
      <% } %>

      <!-- Search & Filter -->
      <section class="co-search-widget mx-auto col-xl-10">
        <form action="/" method="GET" id="searchForm">
          <div class="row g-3 align-items-center justify-content-center">
            <div class="col-md-5 col-sm-12">
              <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control co-form-control border-start-0" name="search" id="searchInput"
                  placeholder="Tìm cà phê, trà, bánh... (<%= totalProducts %>)"
                  value="<%= typeof search !== 'undefined' ? search : '' %>" />
                <% if (typeof search !== 'undefined' && search) { %>
                  <a href="/" class="input-group-text bg-white border-start-0 text-muted" title="Xoá tìm kiếm"><i class="bi bi-x-lg"></i></a>
                <% } %>
              </div>
            </div>
            <div class="col-md-2 col-sm-4">
              <select name="category" class="form-select co-form-control" onchange="this.form.submit()">
                <option value="">Tất cả danh mục</option>
                <% ['Cà phê', 'Trà trái cây', 'Trà sữa', 'Sinh tố', 'Nước ép', 'Bánh ngọt'].forEach(cat => { %>
                  <option value="<%= cat %>" <%= category === cat ? 'selected' : '' %>><%= cat %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-2 col-sm-4">
              <input type="number" class="form-control co-form-control" name="minPrice" placeholder="Giá từ" value="<%= typeof minPrice !== 'undefined' ? minPrice : '' %>" />
            </div>
            <div class="col-md-2 col-sm-4">
              <input type="number" class="form-control co-form-control" name="maxPrice" placeholder="Giá đến" value="<%= typeof maxPrice !== 'undefined' ? maxPrice : '' %>" />
            </div>
            <div class="col-md-2 col-sm-4">
              <select name="rating" class="form-select co-form-control" onchange="this.form.submit()">
                <option value="">Tất cả đánh giá</option>
                <option value="high" <%= rating === 'high' ? 'selected' : '' %>>Đánh giá cao (4-5★)</option>
                <option value="low" <%= rating === 'low' ? 'selected' : '' %>>Đánh giá thấp (1-2★)</option>
              </select>
            </div>
            <div class="col-md-1 col-sm-12">
              <button type="submit" class="co-btn co-btn-primary w-100 py-2"><i class="bi bi-search"></i></button>
            </div>
          </div>
        </form>

        <!-- Category Chips -->
        <div class="d-flex flex-wrap gap-2 mt-3 justify-content-center">
          <%
            const categories = [
              { name: 'Cà phê', icon: 'bi-cup-hot' },
              { name: 'Trà trái cây', icon: 'bi-cup-straw' },
              { name: 'Trà sữa', icon: 'bi-droplet' },
              { name: 'Sinh tố', icon: 'bi-droplets' },
              { name: 'Nước ép', icon: 'bi-cup' },
              { name: 'Bánh ngọt', icon: 'bi-cake' }
            ];
          %>
          <a href="/" class="co-category-chip <%= (!category || category === '') ? 'active' : '' %>">
            <i class="bi bi-grid-3x3-gap me-1"></i> Tất cả
          </a>
          <% categories.forEach(cat => { %>
            <a href="/?category=<%= encodeURIComponent(cat.name) %><%= search ? '&search=' + encodeURIComponent(search) : '' %>"
               class="co-category-chip <%= category === cat.name ? 'active' : '' %>">
              <i class="bi <%= cat.icon %> me-1"></i> <%= cat.name %>
            </a>
          <% }) %>

          <span class="co-category-divider"></span>

          <a href="/?rating=high<%= category ? '&category=' + encodeURIComponent(category) : '' %><%= search ? '&search=' + encodeURIComponent(search) : '' %>"
             class="co-category-chip co-rating-chip <%= rating === 'high' ? 'active' : '' %>">
            <i class="bi bi-star-fill me-1" style="color:var(--co-warning);"></i> Đánh giá cao
          </a>
          <a href="/?rating=low<%= category ? '&category=' + encodeURIComponent(category) : '' %><%= search ? '&search=' + encodeURIComponent(search) : '' %>"
             class="co-category-chip co-rating-chip <%= rating === 'low' ? 'active' : '' %>">
            <i class="bi bi-star-half me-1" style="color:var(--co-danger);"></i> Đánh giá thấp
          </a>
        </div>
      </section>

      <!-- Section Header -->
      <div class="d-flex align-items-center justify-content-between my-5 pt-3">
        <div>
          <span class="co-section-eyebrow">Trải nghiệm vị giác</span>
          <h2 class="font-serif mt-1 mb-0 display-6 fw-bold"><%= (category && category !== '') ? category : 'Thực Đơn' %></h2>
        </div>
        <span class="badge px-3 py-2 fw-semibold" style="background:var(--co-bg);color:var(--co-text-secondary);border:1px solid var(--co-border-strong);font-size:0.85rem;">
          <i class="bi bi-grid-3x3-gap me-1"></i> <%= totalProducts %> sản phẩm
        </span>
      </div>

      <% if (typeof search !== 'undefined' && search) { %>
        <div class="mb-4">
          <span class="text-co-muted">Kết quả cho "<strong><%= search %></strong>"</span>
          <a href="/<%= category ? '?category=' + encodeURIComponent(category) : '' %>" class="ms-2 text-decoration-none fw-semibold" style="color:var(--co-accent);">
            <i class="bi bi-x-circle me-1"></i>Xoá bộ lọc
          </a>
        </div>
      <% } %>

      <!-- Product Grid -->
      <section class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        <% if (products && products.length > 0) { %>
          <% products.forEach(product => { %>
            <div class="col">
              <div class="co-product-card">
                <div class="co-product-img-wrapper">
                  <% if (product.discount > 0) { %>
                    <div class="co-discount-badge">-<%= product.discount %>%</div>
                  <% } %>
                  <img src="<%= product.image %>" alt="<%= product.name %>" class="co-product-img" loading="lazy" />
                </div>
                <div class="co-product-body">
                  <span class="co-product-category"><%= product.category %></span>
                  <h3 class="co-product-title"><%= product.name %></h3>
                  <div class="co-rating-display d-flex align-items-center gap-1 mb-2">
                    <%
                      const avgRating = product.avgRating || 0;
                      const reviewCount = product.reviewCount || 0;
                      const fullStars = Math.floor(avgRating);
                      const hasHalfStar = avgRating - fullStars >= 0.5;
                      const emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);
                    %>
                    <% for (let i = 0; i < fullStars; i++) { %>
                      <i class="bi bi-star-fill text-warning"></i>
                    <% } %>
                    <% if (hasHalfStar) { %>
                      <i class="bi bi-star-half text-warning"></i>
                    <% } %>
                    <% for (let i = 0; i < emptyStars; i++) { %>
                      <i class="bi bi-star text-muted"></i>
                    <% } %>
                    <% if (reviewCount > 0) { %>
                      <span class="text-muted small">(<%= reviewCount %>)</span>
                    <% } %>
                  </div>
                  <% if (product.soldCount && product.soldCount > 0) { %>
                    <div class="co-sold-count d-flex align-items-center gap-1 mb-2" style="color:var(--co-text-muted);font-size:0.75rem;">
                      <i class="bi bi-check2-all"></i> <span>Đã bán: <strong><%= product.soldCount.toLocaleString() %></strong></span>
                    </div>
                  <% } %>
                  <% if (product.description) { %>
                    <p class="small mb-2" style="color:var(--co-text-muted);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;"><%= product.description %></p>
                  <% } %>
                  <div class="co-price-row">
                    <% if (product.discount > 0) { %>
                      <span class="co-price-original"><%= product.price.toLocaleString() %>đ</span>
                      <span class="co-price-current"><%= (product.price * (1 - product.discount / 100)).toLocaleString() %>đ</span>
                    <% } else { %>
                      <span class="co-price-current"><%= product.price.toLocaleString() %>đ</span>
                    <% } %>
                  </div>
                  <div class="d-flex gap-2 flex-nowrap">
                    <a href="/api/products/<%= product.id %>" class="co-btn co-btn-secondary co-btn-sm flex-fill text-decoration-none text-center">
                      <i class="bi bi-eye me-1"></i> Chi tiết
                    </a>
                    <button class="co-btn co-btn-primary co-btn-sm add-to-cart flex-fill" data-id="<%= product.id %>">
                      <i class="bi bi-cart-plus"></i> Mua ngay
                    </button>
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="col-12 text-center py-5">
            <div class="co-empty-state">
              <i class="bi bi-search text-co-muted" style="font-size:3rem;"></i>
              <h4 class="mt-3 font-serif fw-bold">Không tìm thấy sản phẩm</h4>
              <p class="text-co-muted mb-3">Thử thay đổi từ khoá hoặc bộ lọc khác.</p>
              <a href="/" class="co-btn co-btn-primary px-4"><i class="bi bi-arrow-repeat me-2"></i>Xem tất cả</a>
            </div>
          </div>
        <% } %>
      </section>

      <!-- Pagination -->
      <% if (totalPages > 1) { %>
        <nav class="d-flex justify-content-center my-5" aria-label="Phân trang sản phẩm">
          <ul class="pagination">
            <!-- Previous -->
            <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
              <a class="page-link" href="?<%= baseQuery ? baseQuery + '&' : '' %>page=<%= currentPage - 1 %>" aria-label="Trước">
                <i class="bi bi-chevron-left"></i>
              </a>
            </li>

            <!-- Page numbers -->
            <%
              let startPage = Math.max(1, currentPage - 2);
              let endPage = Math.min(totalPages, currentPage + 2);
              if (startPage > 1) { %>
                <li class="page-item">
                  <a class="page-link" href="?<%= baseQuery ? baseQuery + '&' : '' %>page=1">1</a>
                </li>
                <% if (startPage > 2) { %>
                  <li class="page-item disabled"><span class="page-link">...</span></li>
                <% } %>
              <% }
              for (let i = startPage; i <= endPage; i++) { %>
                <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                  <a class="page-link" href="?<%= baseQuery ? baseQuery + '&' : '' %>page=<%= i %>"><%= i %></a>
                </li>
              <% }
              if (endPage < totalPages) { %>
                <% if (endPage < totalPages - 1) { %>
                  <li class="page-item disabled"><span class="page-link">...</span></li>
                <% } %>
                <li class="page-item">
                  <a class="page-link" href="?<%= baseQuery ? baseQuery + '&' : '' %>page=<%= totalPages %>"><%= totalPages %></a>
                </li>
              <% } %>

            <!-- Next -->
            <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
              <a class="page-link" href="?<%= baseQuery ? baseQuery + '&' : '' %>page=<%= currentPage + 1 %>" aria-label="Sau">
                <i class="bi bi-chevron-right"></i>
              </a>
            </li>
          </ul>
        </nav>
      <% } %>
    </main>

    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/script.js"></script>

    <% if (payment === "success") { %>
    <script>
      Swal.fire({
        icon: 'success',
        title: 'Thanh toán thành công!',
        text: 'Cảm ơn bạn đã mua hàng.',
        timer: 4000,
        timerProgressBar: true,
        showConfirmButton: true,
        confirmButtonText: 'OK',
        confirmButtonColor: '#4A2C2A'
      });
    </script>
    <% } %>

    <script src="/client-logger.js"></script>

    <!-- Hero Slider Script -->
    <script>
      (function() {
        const slides = document.querySelectorAll('.co-hero-slide');
        const dots = document.querySelectorAll('.co-hero-dot');
        if (!slides.length) return;
        let current = 0;
        let interval;

        function goTo(index) {
          if (index === current) return;
          slides[current].classList.remove('active');
          dots[current].classList.remove('active');
          current = (index + slides.length) % slides.length;
          slides[current].classList.add('active');
          dots[current].classList.add('active');
        }

        function next() { goTo(current + 1); }
        function prev() { goTo(current - 1); }

        function startAuto() { interval = setInterval(next, 5000); }
        function stopAuto() { clearInterval(interval); }

        document.getElementById('heroNext').addEventListener('click', function() { stopAuto(); next(); startAuto(); });
        document.getElementById('heroPrev').addEventListener('click', function() { stopAuto(); prev(); startAuto(); });
        dots.forEach(function(dot) {
          dot.addEventListener('click', function() {
            stopAuto(); goTo(parseInt(this.dataset.index)); startAuto();
          });
        });

        startAuto();
      })();
    </script>
  </body>
</html>
