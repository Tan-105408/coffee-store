<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Coffee Store - Thưởng thức hương vị tuyệt vời</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <!-- Premium Header & Navbar -->
    <header>
      <nav class="navbar navbar-expand-lg co-navbar navbar-dark sticky-top">
        <div class="container">
          <a class="navbar-brand d-flex align-items-center" href="/">
            <span class="fs-3 me-2">☕</span>
            <span class="font-serif fw-bold">Coffee Store</span>
          </a>
          <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#coNavbar" aria-controls="coNavbar" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          
          <div class="collapse navbar-collapse" id="coNavbar">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
              <li class="nav-item">
                <a class="nav-link active" href="/"><i class="bi bi-house-door me-1"></i> Trang chủ</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/cart"><i class="bi bi-cart3 me-1"></i> Giỏ hàng</a>
              </li>
            </ul>
            
            <div class="d-flex align-items-center gap-2">
              <% if (user && user.role === 'admin') { %>
                <a href="/admin" class="co-btn co-btn-accent text-white px-3 py-2 btn-sm">
                  <i class="bi bi-speedometer2 me-1"></i> Admin Dashboard
                </a>
              <% } %>
              
              <% if (user) { %>
                <div class="dropdown">
                  <button class="co-btn co-btn-secondary dropdown-toggle px-3 py-2 btn-sm text-white" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: rgba(255,255,255,0.15); border: none;">
                    <i class="bi bi-person-circle me-1"></i> 👋 <%= user.username %>
                  </button>
                  <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg mt-2" aria-labelledby="userMenu">
                    <li><a class="dropdown-item py-2" href="/auth/profile"><i class="bi bi-person me-2 text-primary"></i>Hồ sơ cá nhân</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item py-2 text-danger" href="/auth/logout"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                  </ul>
                </div>
              <% } else { %>
                <a href="/auth/login" class="co-btn co-btn-secondary px-3 py-2 btn-sm text-white border-0" style="background-color: rgba(255,255,255,0.1);"><i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập</a>
                <a href="/auth/register" class="co-btn co-btn-accent px-3 py-2 btn-sm"><i class="bi bi-person-plus me-1"></i> Đăng ký</a>
              <% } %>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <!-- Stunning Hero Section -->
    <section class="co-hero">
      <div class="container py-4">
        <h1>Hương vị nồng nàn,<br>Khởi đầu ngày mới</h1>
        <p>Khám phá bộ sưu tập cà phê nguyên chất, các loại trà hảo hạng và bánh ngọt được tuyển chọn đặc biệt cho bạn.</p>
      </div>
    </section>

    <!-- Main Content Container -->
    <main class="container mb-5 position-relative">
      
      <!-- Elegant Search & Filter Panel (Floating) -->
      <section class="co-search-widget mx-auto col-xl-10">
        <form action="/" method="GET" class="row g-3 align-items-center justify-content-center">
          <div class="col-md-4 col-sm-12">
            <div class="input-group">
              <span class="input-group-text bg-white border-end-0 border-1.5" style="border: 1.5px solid rgba(92, 62, 53, 0.12); color: var(--co-primary);"><i class="bi bi-search"></i></span>
              <input
                type="text"
                class="form-control co-form-control border-start-0"
                name="search"
                placeholder="Bạn muốn uống gì?..."
                value="<%= typeof search !== 'undefined' ? search : '' %>" />
            </div>
          </div>
          
          <div class="col-md-2 col-sm-6">
            <select name="category" class="form-select co-form-control">
              <option value="">Tất cả danh mục</option>
              <% ['Cà phê', 'Trà trái cây', 'Trà sữa', 'Sinh tố', 'Nước ép', 'Bánh ngọt'].forEach(cat => { %>
                <option value="<%= cat %>" <%= category === cat ? 'selected' : '' %>>
                  <%= cat %>
                </option>
              <% }) %>
            </select>
          </div>
          
          <div class="col-md-2 col-sm-6">
            <input
              type="number"
              class="form-control co-form-control"
              name="minPrice"
              placeholder="Giá từ (VND)"
              value="<%= typeof minPrice !== 'undefined' ? minPrice : '' %>" />
          </div>
          
          <div class="col-md-2 col-sm-6">
            <input
              type="number"
              class="form-control co-form-control"
              name="maxPrice"
              placeholder="Giá đến (VND)"
              value="<%= typeof maxPrice !== 'undefined' ? maxPrice : '' %>" />
          </div>
          
          <div class="col-md-2 col-sm-6">
            <button type="submit" class="co-btn co-btn-primary w-100 py-2">
              <i class="bi bi-funnel"></i> Tìm kiếm
            </button>
          </div>
        </form>
      </section>

      <!-- Premium Divider & Title -->
      <div class="text-center my-5 pt-4">
        <span class="text-uppercase tracking-wider text-muted fw-bold small">Trải nghiệm vị giác</span>
        <h2 class="font-serif mt-2 mb-3 display-6 fw-bold">Thực Đơn Của Chúng Tôi</h2>
        <div style="width: 60px; height: 3px; background-color: var(--co-secondary); margin: 0 auto;"></div>
      </div>

      <!-- Exquisite Product Grid -->
      <section class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        <% if (products && products.length > 0) { %>
          <% products.forEach(product => { %>
            <div class="col">
              <div class="co-product-card">
                <!-- Image Wrapper with Discount Badge -->
                <div class="co-product-img-wrapper">
                  <% if (product.discount > 0) { %>
                    <div class="co-discount-badge">
                      <i class="bi bi-tag-fill me-1"></i>-<%= product.discount %>%
                    </div>
                  <% } %>
                  <img src="<%= product.image %>" alt="<%= product.name %>" class="co-product-img" />
                </div>
                
                <!-- Card Body -->
                <div class="co-product-body">
                  <span class="text-uppercase text-muted fw-semibold" style="font-size: 0.75rem; letter-spacing: 1px;"><%= product.category %></span>
                  <h3 class="co-product-title mt-1 text-truncate"><%= product.name %></h3>
                  
                  <!-- Price row -->
                  <div class="co-price-row mt-auto">
                    <% if (product.discount > 0) { %>
                      <span class="co-price-original"><%= product.price.toLocaleString() %>đ</span>
                      <span class="co-price-current"><%= (product.price * (1 - product.discount / 100)).toLocaleString() %>đ</span>
                    <% } else { %>
                      <span class="co-price-current"><%= product.price.toLocaleString() %>đ</span>
                    <% } %>
                  </div>
                  
                  <!-- Responsive Action Buttons -->
                  <div class="d-flex gap-2">
                    <a href="/api/products/<%= product.id %>" class="co-btn co-btn-secondary flex-fill py-2 text-decoration-none text-center">
                      Chi tiết
                    </a>
                    <button class="co-btn co-btn-primary add-to-cart flex-fill py-2" data-id="<%= product.id %>">
                      <i class="bi bi-cart-plus"></i> Mua ngay
                    </button>
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="col-12 text-center py-5">
            <div class="mb-3">
              <i class="bi bi-search text-muted" style="font-size: 3rem;"></i>
            </div>
            <p class="text-muted fs-5">Rất tiếc, chúng tôi không tìm thấy sản phẩm phù hợp.</p>
            <a href="/" class="co-btn co-btn-primary px-4 mt-2">Xem tất cả sản phẩm</a>
          </div>
        <% } %>
      </section>
    </main>

    <!-- Exquisite Footer -->
    <footer class="co-footer">
      <div class="container">
        <div class="row g-4">
          <div class="col-lg-4 col-md-12">
            <h4 class="font-serif">☕ Coffee Store</h4>
            <p class="mt-3">Coffee Store mang đến trải nghiệm thưởng thức cà phê nguyên chất và các loại trà hảo hạng trong không gian ấm cúng, sang trọng.</p>
            <div class="d-flex gap-3 mt-4">
              <a href="#" class="fs-4 text-white opacity-75 hover-opacity-100"><i class="bi bi-facebook"></i></a>
              <a href="#" class="fs-4 text-white opacity-75 hover-opacity-100"><i class="bi bi-instagram"></i></a>
              <a href="#" class="fs-4 text-white opacity-75 hover-opacity-100"><i class="bi bi-tiktok"></i></a>
            </div>
          </div>
          <div class="col-lg-2 col-md-4 col-6">
            <h4>Liên kết</h4>
            <ul class="list-unstyled d-flex flex-column gap-2 mt-3">
              <li><a href="/" class="text-decoration-none">Trang chủ</a></li>
              <li><a href="/cart" class="text-decoration-none">Giỏ hàng</a></li>
              <li><a href="/auth/login" class="text-decoration-none">Tài khoản</a></li>
            </ul>
          </div>
          <div class="col-lg-2 col-md-4 col-6">
            <h4>Thực Đơn</h4>
            <ul class="list-unstyled d-flex flex-column gap-2 mt-3">
              <li><a href="/?category=Cà phê" class="text-decoration-none">Cà phê</a></li>
              <li><a href="/?category=Trà trái cây" class="text-decoration-none">Trà trái cây</a></li>
              <li><a href="/?category=Trà sữa" class="text-decoration-none">Trà sữa</a></li>
              <li><a href="/?category=Bánh ngọt" class="text-decoration-none">Bánh ngọt</a></li>
            </ul>
          </div>
          <div class="col-lg-4 col-md-4 col-12">
            <h4>Liên hệ</h4>
            <ul class="list-unstyled d-flex flex-column gap-2 mt-3">
              <li><p class="m-0"><i class="bi bi-geo-alt me-2 text-warning"></i> 33 Xô Viết Nghệ Tĩnh, Đà Nẵng</p></li>
              <li><p class="m-0"><i class="bi bi-telephone me-2 text-warning"></i> 034 7585 7329</p></li>
              <li><p class="m-0"><i class="bi bi-envelope me-2 text-warning"></i> contact@coffeestore.com</p></li>
            </ul>
          </div>
        </div>
        <div class="co-footer-bottom text-center">
          <p class="m-0">&copy; 2026 Coffee Store. Tất cả quyền được bảo lưu.</p>
        </div>
      </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/script.js"></script>
  </body>
</html>
