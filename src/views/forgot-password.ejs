<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quên mật khẩu - Coffee Store</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="row g-0 auth-split">
    <!-- Form Side -->
    <div class="col-md-6 auth-form-side">
      <div class="auth-form-card">
        <a href="/" class="d-inline-flex align-items-center text-decoration-none mb-4" style="color:var(--co-primary);">
          <span class="fs-3 me-2">☕</span>
          <span class="font-serif fw-bold fs-5">Coffee Store</span>
        </a>

        <h2 class="font-serif fw-bold mb-1">Quên Mật Khẩu?</h2>
        <p class="small mb-4" style="color:var(--co-text-muted);">Nhập email đăng ký, chúng tôi sẽ gửi hướng dẫn đặt lại</p>

        <div id="formMessage" class="d-none">
          <div class="text-center py-4">
            <div style="font-size:3rem;">📧</div>
            <h5 class="font-serif fw-bold mt-3">Đã gửi hướng dẫn!</h5>
            <p class="small mt-2" style="color:var(--co-text-muted);" id="messageText">Vui lòng kiểm tra hộp thư email của bạn.</p>
            <a href="/auth/login" class="co-btn co-btn-primary px-4 mt-3">
              <i class="bi bi-arrow-left me-1"></i> Quay lại đăng nhập
            </a>
          </div>
        </div>

        <div id="resetForm">
          <form id="forgotForm">
            <div class="mb-4">
              <label class="form-label fw-semibold small" style="color:var(--co-text-muted);">Địa chỉ Email</label>
              <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-envelope"></i></span>
                <input type="email" name="email" id="email" class="form-control co-form-control border-start-0" placeholder="example@gmail.com" required>
              </div>
            </div>

            <button type="submit" class="co-btn co-btn-primary w-100 py-2.5 mb-3" id="resetBtn">
              <span id="resetBtnText"><i class="bi bi-send me-1"></i> Gửi hướng dẫn</span>
              <span id="resetBtnSpinner" class="spinner-border spinner-border-sm me-2" style="display:none;"></span>
            </button>
          </form>

          <p class="mt-3 text-center mb-0 small" style="color:var(--co-text-muted);">
            Nhớ mật khẩu? <a href="/auth/login" class="fw-bold text-decoration-none" style="color:var(--co-secondary);">Đăng nhập</a>
          </p>
        </div>
      </div>
    </div>

    <!-- Image Side -->
    <div class="col-md-6 d-none d-md-flex auth-image-side" style="background-image:url('https://images.unsplash.com/photo-1498804103079-a6351b050096?w=1200&q=80');">
      <div>
        <span style="font-size:4rem;">☕</span>
        <h1 class="mt-3 font-serif">Đừng Lo!</h1>
        <p class="mt-2 mb-0">Chỉ cần vài bước đơn giản để quay lại thưởng thức cà phê</p>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.getElementById('forgotForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      const email = document.getElementById('email').value.trim();
      if (!email || !email.includes('@')) {
        document.getElementById('email').classList.add('is-invalid');
        return;
      }

      const btn = document.getElementById('resetBtn');
      btn.disabled = true;
      document.getElementById('resetBtnText').style.display = 'none';
      document.getElementById('resetBtnSpinner').style.display = 'inline-block';
      btn.classList.add('opacity-75');

      try {
        const res = await fetch('/auth/forgot-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        });
        const data = await res.json();
        if (res.ok) {
          document.getElementById('resetForm').classList.add('d-none');
          document.getElementById('formMessage').classList.remove('d-none');
          document.getElementById('messageText').textContent = data.message || 'Vui lòng kiểm tra hộp thư email của bạn.';
        } else {
          Swal.fire({ text: data.message || 'Có lỗi xảy ra!', icon: 'error', confirmButtonColor: '#4A2C2A' });
        }
      } catch (err) {
        Swal.fire({ text: 'Có lỗi xảy ra, vui lòng thử lại.', icon: 'error', confirmButtonColor: '#4A2C2A' });
      } finally {
        btn.disabled = false;
        document.getElementById('resetBtnText').style.display = '';
        document.getElementById('resetBtnSpinner').style.display = 'none';
        btn.classList.remove('opacity-75');
      }
    });

    document.getElementById('email').addEventListener('input', function() {
      this.classList.remove('is-invalid');
    });
  </script>
  <script src="/client-logger.js"></script>
</body>
</html>
