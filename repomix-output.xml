                class="form-control co-form-control border-start-0"
                name="search"
                placeholder="Bạn muốn uống gì?..."
                value="<%= typeof search !== 'undefined' ? search : '' %>" />
            </div>
          </div>
          
          <div class="col-md-2 col-sm-6">
            <select name="category" class="form-select co-form-control">
