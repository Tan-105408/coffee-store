  }
};

// ================= LẤY THÔNG TIN NGƯỜI DÙNG =================
if (token) {
  apiFetch("/auth/profile", { method: "GET" })
    .then((response) => {
      if (!response.ok) {
        throw new Error("Không thể xác thực người dùng.");
      }
      return response.json();
    })
    .then((data) => {
      console.log("Người dùng:", data);
      const profileBox = document.getElementById("profile");
      if (profileBox) {
        profileBox.innerText = JSON.stringify(data, null, 2);
      }
    })
    .catch((error) => {
      console.error("Lỗi xác thực:", error.message);
    });
} else {
  console.warn("Chưa có token. Vui lòng đăng nhập.");
}

// ================= THÊM VÀO GIỎ HÀNG =================
// Dùng event delegation để tránh gán nhiều listener hoặc trùng lặp
document.addEventListener("click", async (e) => {
  const button = e.target.closest(".add-to-cart");
  if (button) {
    const productId = button.getAttribute("data-id");
    
    // Kiểm tra nếu ở trang chi tiết có input quantity
    const quantityInput = document.getElementById("quantity");
    const quantity = quantityInput ? parseInt(quantityInput.value) : 1;

    if (!productId) {
      console.error("ProductId không xác định");
      return;
    }

    try {
      const response = await apiFetch("/cart/add", {
        method: "POST",
        body: JSON.stringify({ productId, quantity }),
      });
      const data = await response.json();
      if (data.success) {
        showToast("Đã thêm sản phẩm vào giỏ hàng thành công!");
        // Nếu đang ở trang chi tiết thì chuyển hướng về giỏ hàng sau 1 giây cho mượt mà
        if (window.location.pathname.includes("/api/products/")) {
          setTimeout(() => {
            window.location.href = "/cart";
          }, 1200);
        }
      } else {
        showToast(data.message || "Lỗi khi thêm sản phẩm vào giỏ.", "error");
      }
    } catch (error) {
      showToast("Có lỗi xảy ra khi thêm sản phẩm.", "error");
      console.error(error);
    }
  }
});

// ================= XÓA SẢN PHẨM KHỎI GIỎ =================
document.querySelectorAll(".remove-item").forEach((button) => {
  button.addEventListener("click", async (e) => {
    const productId = e.target.getAttribute("data-id");
    if (!productId) {
      console.error("ProductId không xác định khi xóa");
      return;
    }

    if (typeof Swal !== 'undefined') {
      const confirmation = await Swal.fire({
        title: 'Xác nhận xóa?',
        text: "Bạn có chắc chắn muốn xóa sản phẩm này khỏi giỏ hàng?",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#e76f51',
        cancelButtonColor: '#7d706a',
        confirmButtonText: 'Đồng ý xóa',
        cancelButtonText: 'Hủy bỏ',
        background: '#fdfbf7',
        color: '#2b221e',
        customClass: {
          popup: 'rounded-4 border-0 shadow-lg',
          confirmButton: 'co-btn px-4',
          cancelButton: 'co-btn px-4'
        }
      });

      if (!confirmation.isConfirmed) return;
    } else {
      if (!confirm("Bạn có muốn xóa sản phẩm khỏi giỏ?")) return;
    }

    try {
      const response = await apiFetch(`/cart/remove/${productId}`, {
        method: "DELETE",
      });
      const data = await response.json();
      if (response.ok) {
        showToast("Đã xóa sản phẩm khỏi giỏ hàng!");
        setTimeout(() => {
          window.location.reload();
        }, 1000);
      } else {
        showToast(data.message || "Lỗi khi xóa sản phẩm khỏi giỏ.", "error");
      }
    } catch (error) {
      showToast("Có lỗi xảy ra khi xóa sản phẩm.", "error");
      console.error(error);
    }
  });
});
</file>

<file path="src/public/style.css">
/* ==========================================================================
   Coffee Store - Cohesive Professional Design System
   ========================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap');

:root {
  /* Elegant Coffee Palette */
  --co-primary: #5c3e35;        /* Deep Espresso Brown */
  --co-primary-dark: #3e2720;   /* Rich Dark Chocolate */
  --co-primary-light: #8d6e63;  /* Smooth Latte */
  --co-secondary: #d4a373;      /* Golden Caramel Accent */
  --co-accent: #e76f51;         /* Warm Coral Peach (Discount/Alert) */
  --co-success: #2a9d8f;        /* Teal Green (Success) */
  --co-bg: #fdfbf7;             /* Soft Cream Background */
  --co-bg-card: #ffffff;        /* White Card Background */
  --co-text-main: #2b221e;      /* Off-black Charcoal */
  --co-text-muted: #7d706a;     /* Soft Muted Gray-Brown */
  
  /* Modern UI Constants */
  --co-font-sans: 'Plus Jakarta Sans', sans-serif;
  --co-font-serif: 'Playfair Display', serif;
  --co-shadow-sm: 0 4px 6px rgba(92, 62, 53, 0.04);
  --co-shadow-md: 0 10px 25px rgba(92, 62, 53, 0.08);
  --co-shadow-lg: 0 20px 40px rgba(92, 62, 53, 0.12);
  --co-transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  --co-radius: 16px;
}

/* Base Styles */
body {
  font-family: var(--co-font-sans);
  background-color: var(--co-bg);
  color: var(--co-text-main);
  line-height: 1.6;
  overflow-x: hidden;
}

h1, h2, h3, h4, h5, h6 {
  font-family: var(--co-font-sans);
  font-weight: 700;
  color: var(--co-primary-dark);
}

.font-serif {
  font-family: var(--co-font-serif);
}

a {
  color: var(--co-primary);
  text-decoration: none;
  transition: var(--co-transition);
}

a:hover {
  color: var(--co-secondary);
}

/* Custom Glassmorphic Header */
.co-navbar {
  background: rgba(92, 62, 53, 0.95) !important;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  transition: var(--co-transition);
}

.co-navbar .navbar-brand {
  font-family: var(--co-font-serif);
  font-size: 1.6rem;
  font-weight: 700;
  color: #fff !important;
}

.co-navbar .nav-link {
  color: rgba(255, 255, 255, 0.85) !important;
  font-weight: 500;
  padding: 0.5rem 1rem !important;
  border-radius: 8px;
  transition: var(--co-transition);
}

.co-navbar .nav-link:hover,
.co-navbar .nav-link.active {
  color: #fff !important;
  background-color: rgba(255, 255, 255, 0.12);
}

/* Elegant Hero Section */
.co-hero {
  position: relative;
  background: linear-gradient(rgba(40, 27, 23, 0.65), rgba(40, 27, 23, 0.75)), 
              url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat;
  padding: 100px 0 120px;
  color: #fff;
  text-align: center;
  border-radius: 0 0 40px 40px;
  margin-bottom: -50px;
  z-index: 1;
}

.co-hero h1 {
  font-family: var(--co-font-serif);
  font-size: 3.5rem;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 4px 12px rgba(0, 0, 0, 0.3);
  margin-bottom: 1.5rem;
}

.co-hero p {
  font-size: 1.25rem;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.9);
  max-width: 600px;
  margin: 0 auto 2rem;
  text-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
}

/* Floating Search and Filter Widget */
.co-search-widget {
  position: relative;
  background: var(--co-bg-card);
  border-radius: var(--co-radius);
  box-shadow: var(--co-shadow-lg);
  padding: 24px;
  z-index: 10;
  border: 1px solid rgba(92, 62, 53, 0.06);
}

.co-form-control {
  border: 1.5px solid rgba(92, 62, 53, 0.12);
  border-radius: 10px;
  padding: 10px 16px;
  font-size: 0.95rem;
  color: var(--co-text-main);
  background-color: #fcfbfa;
  transition: var(--co-transition);
}

.co-form-control:focus {
  border-color: var(--co-primary);
  box-shadow: 0 0 0 4px rgba(92, 62, 53, 0.1);
  background-color: #fff;
  outline: none;
}

/* Custom Buttons */
.co-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-weight: 600;
  border-radius: 12px;
  padding: 10px 24px;
  transition: var(--co-transition);
  cursor: pointer;
  border: none;
  font-size: 0.95rem;
}

.co-btn-primary {
  background-color: var(--co-primary);
  color: #fff !important;
}

.co-btn-primary:hover {
  background-color: var(--co-primary-dark);
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(92, 62, 53, 0.2);
}

.co-btn-secondary {
  background-color: #faefe6;
  color: var(--co-primary) !important;
  border: 1px solid rgba(92, 62, 53, 0.1);
}

.co-btn-secondary:hover {
  background-color: var(--co-primary);
  color: #fff !important;
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(92, 62, 53, 0.1);
}

.co-btn-accent {
  background-color: var(--co-secondary);
  color: #fff !important;
}

.co-btn-accent:hover {
  background-color: #be8e5d;
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(212, 163, 115, 0.3);
}

/* Exquisite Product Cards */
.co-product-card {
  background: var(--co-bg-card);
  border-radius: var(--co-radius);
  border: 1px solid rgba(92, 62, 53, 0.05);
  overflow: hidden;
  box-shadow: var(--co-shadow-sm);
  transition: var(--co-transition);
  height: 100%;
  display: flex;
  flex-direction: column;
}

.co-product-card:hover {
  transform: translateY(-8px);
  box-shadow: var(--co-shadow-lg);
  border-color: rgba(212, 163, 115, 0.3);
}

.co-product-img-wrapper {
  position: relative;
  height: 230px;
  overflow: hidden;
}

.co-product-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: var(--co-transition);
}

.co-product-card:hover .co-product-img {
  transform: scale(1.08);
}

.co-discount-badge {
  position: absolute;
  top: 15px;
  right: 15px;
  background-color: var(--co-accent);
  color: #fff;
  padding: 6px 12px;
  font-weight: 700;
  font-size: 0.8rem;
  border-radius: 30px;
  box-shadow: 0 4px 10px rgba(231, 111, 81, 0.3);
  z-index: 2;
}

.co-product-body {
  padding: 22px;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.co-product-title {
  font-size: 1.15rem;
  font-weight: 700;
  margin-bottom: 10px;
  color: var(--co-primary-dark);
  line-height: 1.4;
}

.co-price-row {
  margin-bottom: 20px;
  display: flex;
  align-items: baseline;
  gap: 8px;
}

.co-price-current {
  font-size: 1.25rem;
  font-weight: 800;
  color: var(--co-secondary);
}

.co-price-original {
  font-size: 0.95rem;
  color: var(--co-text-muted);
  text-decoration: line-through;
}

/* Beautiful Details Page Layout */
.co-detail-card {
  background: var(--co-bg-card);
  border-radius: var(--co-radius);
  box-shadow: var(--co-shadow-md);
  padding: 40px;
  border: 1px solid rgba(92, 62, 53, 0.05);
}

.co-detail-img {
  width: 100%;
  border-radius: var(--co-radius);
  box-shadow: var(--co-shadow-md);
  object-fit: cover;
  height: 450px;
}

.co-review-card {
  background: var(--co-bg-card);
  border-radius: 12px;
  padding: 20px;
  border-left: 5px solid var(--co-secondary);
  box-shadow: var(--co-shadow-sm);
  margin-bottom: 16px;
  transition: var(--co-transition);
}

.co-review-card:hover {
  transform: translateX(5px);
  box-shadow: var(--co-shadow-md);
}

/* Exquisite Shopping Cart */
.co-cart-table {
  background: var(--co-bg-card);
  border-radius: var(--co-radius);
  overflow: hidden;
  box-shadow: var(--co-shadow-sm);
  border: 1px solid rgba(92, 62, 53, 0.05);
}

.co-cart-table th {
  background-color: var(--co-primary);
  color: #fff;
  font-weight: 600;
  padding: 18px !important;
  border: none;
}

.co-cart-table td {
  padding: 18px !important;
  vertical-align: middle;
}

.co-summary-card {
  background: var(--co-bg-card);
  border-radius: var(--co-radius);
  box-shadow: var(--co-shadow-md);
  padding: 30px;
  border: 1px solid rgba(92, 62, 53, 0.05);
}

/* Modern Auth (Login/Register) Panels */
.co-auth-card {
  max-width: 450px;
  margin: 60px auto;
  background: var(--co-bg-card);
  padding: 40px;
  border-radius: var(--co-radius);
  box-shadow: var(--co-shadow-lg);
  border: 1px solid rgba(92, 62, 53, 0.05);
}

.co-auth-logo {
  font-family: var(--co-font-serif);
  font-size: 2.2rem;
  font-weight: 800;
  color: var(--co-primary);
  text-align: center;
  margin-bottom: 1rem;
}

/* Google SSO Button */
.co-google-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  width: 100%;
  padding: 12px;
  background-color: #fff;
  border: 1.5px solid rgba(92, 62, 53, 0.12);
  border-radius: 12px;
  color: var(--co-text-main);
  font-weight: 600;
  transition: var(--co-transition);
}

.co-google-btn:hover {
  background-color: #faf9f7;
  border-color: var(--co-primary-light);
  transform: translateY(-2px);
  box-shadow: var(--co-shadow-sm);
}

/* Beautiful Footer */
.co-footer {
  background-color: var(--co-primary-dark);
  color: rgba(255, 255, 255, 0.7);
  padding: 80px 0 30px;
  border-radius: 40px 40px 0 0;
  margin-top: 80px;
}

.co-footer h4 {
  font-family: var(--co-font-serif);
  color: #fff;
  font-size: 1.3rem;
  font-weight: 700;
  margin-bottom: 24px;
}

.co-footer a {
  color: rgba(255, 255, 255, 0.75);
  transition: var(--co-transition);
}

.co-footer a:hover {
  color: var(--co-secondary);
  padding-left: 4px;
}

.co-footer-bottom {
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  padding-top: 25px;
  margin-top: 40px;
  font-size: 0.9rem;
}

/* custom scrollbar */
::-webkit-scrollbar {
  width: 8px;
}
::-webkit-scrollbar-track {
  background: var(--co-bg);
}
::-webkit-scrollbar-thumb {
  background: var(--co-primary-light);
  border-radius: 10px;
}
::-webkit-scrollbar-thumb:hover {
  background: var(--co-primary);
}
</file>

<file path="src/views/cart.ejs">
<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giỏ hàng của bạn - Coffee Store</title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body class="d-flex flex-column min-vh-100 bg-light">
    <!-- Navbar -->
    <header>
      <nav class="navbar navbar-expand-lg co-navbar navbar-dark sticky-top">
        <div class="container">
          <a class="navbar-brand d-flex align-items-center" href="/">
            <span class="fs-3 me-2">☕</span>
            <span class="font-serif fw-bold">Coffee Store</span>
          </a>
          <div class="navbar-nav ms-auto">
            <a class="nav-link" href="/"><i class="bi bi-house-door me-1"></i> Trang chủ</a>
          </div>
        </div>
      </nav>
    </header>

    <main class="container flex-grow-1 py-5">
      <div class="d-flex align-items-center mb-4 gap-3">
        <h2 class="font-serif fw-bold m-0"><i class="bi bi-cart3 me-2"></i> Giỏ hàng của bạn</h2>
        <% if (cart && Array.isArray(cart) && cart.length > 0) { %>
          <span class="badge bg-secondary rounded-pill px-3 py-2"><%= cart.length %> sản phẩm</span>
        <% } %>
      </div>

      <% if (cart && Array.isArray(cart) && cart.length > 0) {%>
        <div class="row g-4">
          <!-- Table Section -->
          <div class="col-lg-8">
            <div class="co-cart-table table-responsive shadow-sm">
              <table class="table align-middle m-0">
                <thead>
                  <tr>
                    <th class="ps-4">Sản phẩm</th>
                    <th>Đơn giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                    <th class="text-center">Hành động</th>
                  </tr>
                </thead>
                <tbody>
                  <% cart && Array.isArray(cart) && cart.forEach(item => { %>
                    <tr>
                      <td class="ps-4">
                        <div class="d-flex align-items-center gap-3">
                          <img src="<%= item.product.image %>" alt="<%= item.product.name %>" class="rounded-3" style="width: 70px; height: 70px; object-fit: cover;" />
                          <span class="fw-semibold text-dark"><%= item.product.name %></span>
                        </div>
                      </td>
                      <td>
                        <div class="fw-bold text-dark">
                          <%= item.priceAfterDiscount ? item.priceAfterDiscount.toLocaleString() : item.product.price.toLocaleString() %>đ
                        </div>
                        <% if (item.product.discount > 0) { %>
                          <small class="text-decoration-line-through text-muted small"><%= item.product.price.toLocaleString() %>đ</small>
                        <% } %>
                      </td>
                      <td>
                        <div class="d-flex align-items-center gap-2">
                          <button class="btn btn-sm btn-outline-secondary qty-btn" data-action="decrease" data-id="<%= item.product.id %>">
                            <i class="bi bi-dash"></i>
                          </button>
                          <span class="badge bg-light text-dark border px-3 py-2 fw-bold"><%= item.quantity %></span>
                          <button class="btn btn-sm btn-outline-secondary qty-btn" data-action="increase" data-id="<%= item.product.id %>">
                            <i class="bi bi-plus"></i>
                          </button>
                        </div>
                      </td>
                      <td class="fw-bold text-primary"><%= item.total.toLocaleString() %>đ</td>
                      <td class="text-center">
                        <button class="btn btn-outline-danger btn-sm remove-item border-0" data-id="<%= item.product.id %>" title="Xóa">
                          <i class="bi bi-trash"></i>
                        </button>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Summary Section -->
          <div class="col-lg-4">
            <div class="co-summary-card shadow-lg sticky-top" style="top: 100px;">
              <h4 class="font-serif fw-bold mb-4">Tổng quan đơn hàng</h4>
              <div class="d-flex justify-content-between mb-3">
                <span class="text-muted">Tạm tính:</span>
                <span class="fw-bold text-dark"><%= total.toLocaleString() %>đ</span>
              </div>
              <div class="d-flex justify-content-between mb-4 border-top pt-3">
                <span class="fw-bold fs-5">Tổng cộng:</span>
                <span class="fw-bold fs-4 text-success" style="color: var(--co-success) !important;"><%= total.toLocaleString() %>đ</span>
              </div>
              <a href="/checkout" class="co-btn co-btn-primary w-100 py-3 text-uppercase fw-bold shadow-sm">
                <i class="bi bi-credit-card me-2"></i> Thanh toán ngay
              </a>
              <a href="/" class="co-btn co-btn-secondary w-100 mt-3 py-2 text-decoration-none">
                <i class="bi bi-arrow-left me-2"></i> Tiếp tục mua sắm
              </a>
            </div>
          </div>
        </div>
      <% } else { %>
        <!-- Empty Cart -->
        <div class="text-center bg-white p-5 rounded-4 shadow-sm border border-light">
          <i class="bi bi-cart-x text-muted" style="font-size: 4rem;"></i>
          <h4 class="mt-4 font-serif fw-bold">Giỏ hàng của bạn đang trống!</h4>
          <p class="text-muted mb-4">Hãy khám phá thêm các món ngon tuyệt hảo của chúng tôi.</p>
          <a href="/" class="co-btn co-btn-primary px-4 py-2">
            <i class="bi bi-shop me-2"></i> Mua sắm ngay
          </a>
        </div>
      <% } %>
    </main>

    <!-- Footer -->
    <footer class="co-footer mt-5">
      <div class="container text-center">
        <p class="m-0 text-white-50 small">&copy; 2026 Coffee Store. Tất cả quyền được bảo lưu.</p>
      </div>
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/script.js"></script>
    <script>
      // Quantity control handlers
      document.querySelectorAll('.qty-btn').forEach(btn => {
        btn.addEventListener('click', async function() {
          const productId = this.dataset.id;
          const action = this.dataset.action;

          try {
            const response = await fetch('/cart/update', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ productId, action })
            });

            if (response.ok) {
              location.reload();
            } else {
              const data = await response.json();
              Swal.fire({ icon: 'error', text: data.message || 'Lỗi cập nhật giỏ hàng' });
            }
          } catch (error) {
            console.error('Error:', error);
