                      <span class="co-price-original"><%= product.price.toLocaleString() %>đ</span>
                      <span class="co-price-current"><%= (product.price * (1 - product.discount / 100)).toLocaleString() %>đ</span>
                    <% } else { %>
                      <span class="co-price-current"><%= product.price.toLocaleString() %>đ</span>
                    <% } %>
                  </div>
                  
                  <!-- Responsive Action Buttons -->
                  <div class="d-flex gap-2">
                    <a href="/api/products/<%= product.id %>" class="co-btn co-btn-secondary flex-fill py-2 text-decoration-none text-center">
